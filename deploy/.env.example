# Semantix 部署环境变量样板。
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env 已被 .gitignore 忽略（*.env 规则），不会被提交；本样板通过
# !*.env.example 显式保留。所有凭据只走环境变量，不要写进 docker-compose.yml
# 或任何 .toml（CONTRIBUTING.md:31）。
#
# 基础两服务在 docker-compose.yml 中用 ${VAR:?} 引用：未设置或留空都会让
# `docker compose up` 直接失败并提示变量名，不会静默启动一个没有凭据的服务。

# --- 基础两服务（默认部署，必填）-------------------------------------------

# 客户端访问 semantix-gateway 所用的 key，自行生成一个随机串即可。
#   生成建议：openssl rand -hex 32
SEMANTIX_GATEWAY_KEY=

# 上游 LLM 的 API key。
DEEPSEEK_API_KEY=

# --- 可选 · Milvus 向量库（仅叠加 docker-compose.milvus.yml 时需要）---------
#
# 两者都没有默认值：docker-compose.milvus.yml 用 ${VAR:?} 语法，未设置即启动
# 失败。这是刻意的 —— minioadmin/minioadmin 这类弱口令不应该存在于任何一份
# 可直接拉起的部署里。
#
# 生成建议：openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Milvus 开启了鉴权（deploy/milvus-user.yaml）。镜像首次启动会建默认账号
# root / Milvus —— 首次连上后必须立即改密，改法见 docs/integrations/milvus.md。
# 该密码由 Milvus 自身持久化在 etcd 里，不通过环境变量注入。
