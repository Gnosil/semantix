# Semantix 部署环境变量样板。
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env 已被 .gitignore 忽略（*.env），不会被提交。所有凭据只走环境变量，
# 不要写进 docker-compose.yml 或任何 .toml（CONTRIBUTING.md:31）。

# --- 基础两服务（默认 profile，必填）---------------------------------------

# 客户端访问 semantix-gateway 所用的 key，自行生成一个随机串即可。
SEMANTIX_GATEWAY_KEY=

# 上游 LLM 的 API key。
DEEPSEEK_API_KEY=

# --- 可选 · Milvus 向量库（仅 --profile milvus 时需要）----------------------
#
# 两者都没有默认值：compose 用 ${VAR:?} 语法，未设置即启动失败。这是刻意的 ——
# minioadmin/minioadmin 这类弱口令不应该存在于任何一份可直接拉起的部署里。
#
# 生成建议：openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Milvus 开启了鉴权（deploy/milvus-user.yaml）。镜像首次启动会建默认账号
# root / Milvus —— 首次连上后必须立即改密，改法见 docs/integrations/milvus.md。
# 该密码由 Milvus 自身持久化在 etcd 里，不通过环境变量注入。
