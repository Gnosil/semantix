{
  "name": "semantix-site",
  "version": "0.1.0",
  "private": true,
  "description": "Semantix official landing page — a self-evolving agent kernel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gnosil/semantix.git"
  },
  "keywords": [
    "semantix",
    "agent",
    "kernel",
    "nextjs",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "generate:llms-full": "node scripts/generate-llms-full.mjs",
    "prebuild": "node --test scripts/source-encoding.test.mjs && node scripts/generate-llms-full.mjs",
    "build": "next build",
    "start": "next start",
    "test:content": "node --test scripts/*.test.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:content"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
